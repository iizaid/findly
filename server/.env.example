DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findly?schema=public"
NODE_ENV="development"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
COOKIE_NAME="findly_session"
CSRF_COOKIE_NAME="findly_csrf"

# ==============================================================
# PRODUCTION COOKIE CONFIGURATION MODES
# ==============================================================
# Mode A: Same parent domain (Recommended)
# e.g., frontend: https://app.findly.com, backend: https://api.findly.com
# COOKIE_SAME_SITE="lax"
# COOKIE_SECURE=true
# COOKIE_DOMAIN=".findly.com"
# CSRF_COOKIE_SAME_SITE="lax"
# CSRF_COOKIE_SECURE=true
# CSRF_COOKIE_DOMAIN=".findly.com"

# Mode B: Separate hosting domains
# e.g., frontend: https://findly.vercel.app, backend: https://findly.onrender.com
# COOKIE_SAME_SITE="none"
# COOKIE_SECURE=true
# CSRF_COOKIE_SAME_SITE="none"
# CSRF_COOKIE_SECURE=true
# (Do not set COOKIE_DOMAIN in Mode B)
# ==============================================================

SESSION_TTL_DAYS=30
SESSION_SHORT_TTL_HOURS=2
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_ATTEMPT_TTL_MINUTES=15
MAX_ACTIVE_SESSIONS=10
BCRYPT_ROUNDS=12

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_MAX=8
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_TTL_MINUTES=45
SEARCH_RATE_LIMIT_MAX=20
ANALYSIS_RATE_LIMIT_MAX=30
SEARCH_RUN_RATE_LIMIT_MAX=20
ANALYSIS_RUN_RATE_LIMIT_MAX=30

JSON_BODY_LIMIT="100kb"
URLENCODED_BODY_LIMIT="50kb"
TRUST_PROXY=1
LOG_LEVEL="info"

EMAIL_VERIFICATION_TTL_MINUTES=60
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
APP_URL="http://localhost:4000"
CLIENT_URL="http://localhost:5173"

SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="Findly <your-email@gmail.com>"

GOOGLE_PLACES_API_KEY=""
YELP_API_KEY=""
SEARCH_METADATA_PROVIDER_PRIMARY=serper
SEARCH_METADATA_PROVIDER_FALLBACK=serpapi
LIVE_SEARCH_METADATA_DISCOVERY_ENABLED=false
SEARCH_METADATA_MAX_QUERIES_PER_CAMPAIGN=5
SEARCH_METADATA_MAX_QUERY_LENGTH=180
SEARCH_METADATA_MIN_PROVIDER_RESULTS=3
SEARCH_METADATA_MIN_AVERAGE_CONFIDENCE=55
SERPER_API_KEY=""
SERPER_BASE_URL="https://google.serper.dev/search"
SERPER_TIMEOUT_MS=10000
SERPAPI_API_KEY=""
LIVE_SERP_DISCOVERY_ENABLED=false
SERPAPI_BASE_URL="https://serpapi.com/search.json"
SERPAPI_TIMEOUT_MS=10000
SERPAPI_MAX_QUERIES_PER_CAMPAIGN=5
DISCOVERY_DASHBOARD_SECRET_MANAGEMENT_ENABLED=false
DISCOVERY_SECRETS_MASTER_KEY=""

# AI keys are backend-only. Never expose these through VITE_ variables.
AI_ENABLED=false
AI_STRICT_SECURITY_MODE=true
AI_STORE_RAW_PAYLOADS=false
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false
AI_ALLOW_PROMPT_LOGGING_IN_PRODUCTION=false
AI_DEFAULT_PROVIDER="gemini"
AI_DEFAULT_MODEL="gemini-2.5-flash"
AI_DEFAULT_TASK_PROVIDER="gemini"
AI_DEFAULT_TASK_MODEL="gemini-2.5-flash"
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_PROVIDER_CHAIN="gemini,openai,anthropic,deepseek,kimi,qwen,rule_based"
AI_ANALYSIS_TIMEOUT_MS=20000
AI_ANALYSIS_MAX_RETRIES=1
AI_ANALYSIS_CONCURRENCY=2
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"
DEEPSEEK_API_KEY=""
DEEPSEEK_DEFAULT_MODEL=""
DEEPSEEK_BASE_URL=""
KIMI_API_KEY=""
KIMI_DEFAULT_MODEL=""
KIMI_BASE_URL=""
QWEN_API_KEY=""
QWEN_DEFAULT_MODEL=""
QWEN_BASE_URL=""

# Generate only if dashboard-managed AI provider secrets are enabled:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_SECRETS_MASTER_KEY=""
AI_DASHBOARD_SECRET_MANAGEMENT_ENABLED=false

REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="Findly/0.1 by your-reddit-username"
REDDIT_REFRESH_TOKEN=""
REDDIT_ACCESS_TOKEN_URL="https://www.reddit.com/api/v1/access_token"
REDDIT_API_BASE_URL="https://oauth.reddit.com"
REDDIT_REQUEST_TIMEOUT_MS=10000
REDDIT_MAX_RESULTS_DEFAULT=25
REDDIT_MAX_RESULTS_HARD_LIMIT=50

DATASET_IMPORT_DIR="../Data"
DATASET_IMPORT_MODE="global"
IMPORT_AS_ADMIN="true"

WEBSITE_FETCH_TIMEOUT_MS=5000
SOURCE_REQUEST_TIMEOUT_MS=10000
SOURCE_MAX_RESULTS_DEFAULT=20
SOURCE_MAX_RESULTS_HARD_LIMIT=100
JOB_STALE_TIMEOUT_MINUTES=60
ENABLE_WORKER=false
QUEUE_DRIVER=postgres
REDIS_URL=""
MAX_SEARCH_WORKER_CONCURRENCY=2
SEARCH_QUEUE_CONCURRENCY=2
SEARCH_QUEUE_RATE_LIMIT_MAX=
SEARCH_QUEUE_RATE_LIMIT_DURATION_MS=
WORKER_POLL_INTERVAL_MS=1000
WORKER_ID=""
MAX_QUEUED_SEARCH_JOBS=100
MAX_RUNNING_SEARCH_JOBS=10
MAX_ACTIVE_SEARCH_JOBS_PER_USER=2
LOCAL_DATASET_CANDIDATE_LIMIT=1000
CACHE_TTL_SECONDS=300
