DATABASE_URL="postgresql://postgres:postgres@localhost:5432/findly?schema=public"
NODE_ENV="development"
PORT=4000
CLIENT_ORIGIN="http://localhost:5173,http://127.0.0.1:5173"

SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
COOKIE_NAME="findly_session"
CSRF_COOKIE_NAME="findly_csrf"

# ==============================================================
# PRODUCTION COOKIE CONFIGURATION MODES
# ==============================================================
# Mode A: Same parent domain (Recommended)
# e.g., frontend: https://app.findly.com, backend: https://api.findly.com
# COOKIE_SAME_SITE="lax"
# COOKIE_SECURE=true
# COOKIE_DOMAIN=".findly.com"
# CSRF_COOKIE_SAME_SITE="lax"
# CSRF_COOKIE_SECURE=true
# CSRF_COOKIE_DOMAIN=".findly.com"

# Mode B: Separate hosting domains
# e.g., frontend: https://findly.vercel.app, backend: https://findly.onrender.com
# COOKIE_SAME_SITE="none"
# COOKIE_SECURE=true
# CSRF_COOKIE_SAME_SITE="none"
# CSRF_COOKIE_SECURE=true
# (Do not set COOKIE_DOMAIN in Mode B)
# ==============================================================

SESSION_TTL_DAYS=30
SESSION_SHORT_TTL_HOURS=2
FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_ATTEMPT_TTL_MINUTES=15
MAX_ACTIVE_SESSIONS=10
BCRYPT_ROUNDS=12

AUTH_ABUSE_PROTECTION_ENABLED=true
AUTH_ABUSE_AUDIT_THROTTLE_MS=60000
AUTH_MIN_FORM_DURATION_MS=1200
SIGNUP_IP_WINDOW_MS=3600000
SIGNUP_IP_MAX=5
SIGNUP_IP_DAILY_MAX=20
SIGNUP_EMAIL_DOMAIN_WINDOW_MS=3600000
SIGNUP_EMAIL_DOMAIN_MAX=20
SIGNUP_EMAIL_HASH_WINDOW_MS=86400000
SIGNUP_EMAIL_HASH_MAX=3
DISPOSABLE_EMAIL_BLOCKLIST_ENABLED=false
DISPOSABLE_EMAIL_DOMAINS=""
LOGIN_EMAIL_WINDOW_MS=900000
LOGIN_EMAIL_MAX_FAILED=5
LOGIN_IP_WINDOW_MS=900000
LOGIN_IP_MAX_FAILED=20
LOGIN_IP_EMAIL_WINDOW_MS=900000
LOGIN_IP_EMAIL_MAX_FAILED=5
LOGIN_IP_DISTINCT_EMAIL_WINDOW_MS=900000
LOGIN_IP_DISTINCT_EMAIL_MAX=10
LOGIN_EMAIL_DISTINCT_IP_WINDOW_MS=900000
LOGIN_EMAIL_DISTINCT_IP_MAX=10
LOGIN_DELAY_MAX_MS=1500
PASSWORD_RESET_EMAIL_WINDOW_MS=3600000
PASSWORD_RESET_EMAIL_MAX=3
PASSWORD_RESET_IP_WINDOW_MS=3600000
PASSWORD_RESET_IP_MAX=10
PASSWORD_RESET_IP_EMAIL_WINDOW_MS=3600000
PASSWORD_RESET_IP_EMAIL_MAX=3
VERIFICATION_RESEND_IP_WINDOW_MS=3600000
VERIFICATION_RESEND_IP_MAX=10
VERIFICATION_RESEND_USER_WINDOW_MS=3600000
VERIFICATION_RESEND_USER_MAX=3

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20
SIGNUP_RATE_LIMIT_MAX=8
LOGIN_RATE_LIMIT_MAX=8
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=900000
PASSWORD_RESET_RATE_LIMIT_MAX=5
PASSWORD_RESET_TTL_MINUTES=45
SEARCH_RATE_LIMIT_MAX=20
ANALYSIS_RATE_LIMIT_MAX=30
SEARCH_RUN_RATE_LIMIT_MAX=20
ANALYSIS_RUN_RATE_LIMIT_MAX=30

JSON_BODY_LIMIT="100kb"
URLENCODED_BODY_LIMIT="50kb"
TRUST_PROXY=1
LOG_LEVEL="info"

EMAIL_VERIFICATION_TTL_MINUTES=60
VERIFICATION_RESEND_COOLDOWN_SECONDS=60
APP_URL="http://localhost:4000"
CLIENT_URL="http://localhost:5173"

TWO_FACTOR_AUTH_ENABLED=true
# Base64-encoded 32-byte minimum key for AES-256-GCM secret encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TWO_FACTOR_SECRET_ENCRYPTION_KEY=""
TWO_FACTOR_ISSUER="Findly"
TWO_FACTOR_LOGIN_CHALLENGE_TTL_MINUTES=10
TWO_FACTOR_LOGIN_MAX_ATTEMPTS=5
TWO_FACTOR_SETUP_CONFIRM_WINDOW_MS=600000
TWO_FACTOR_SETUP_CONFIRM_MAX=5
TWO_FACTOR_LOGIN_VERIFY_WINDOW_MS=900000
TWO_FACTOR_LOGIN_VERIFY_MAX=10
TWO_FACTOR_DISABLE_WINDOW_MS=900000
TWO_FACTOR_DISABLE_MAX=5
TWO_FACTOR_BACKUP_REGENERATE_WINDOW_MS=900000
TWO_FACTOR_BACKUP_REGENERATE_MAX=5

OAUTH_ENABLED=false
OAUTH_STATE_TTL_MINUTES=10
OAUTH_ALLOWED_RETURN_PATHS="/dashboard,/settings,/billing"
OAUTH_DEFAULT_SUCCESS_PATH="/dashboard"
OAUTH_FAILURE_PATH="/auth"
OAUTH_START_IP_WINDOW_MS=600000
OAUTH_START_IP_MAX=30
OAUTH_CALLBACK_IP_WINDOW_MS=600000
OAUTH_CALLBACK_IP_MAX=60
OAUTH_SIGNUP_IP_WINDOW_MS=3600000
OAUTH_SIGNUP_IP_MAX=8
OAUTH_SIGNUP_DOMAIN_WINDOW_MS=3600000
OAUTH_SIGNUP_DOMAIN_MAX=25

GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/api/auth/oauth/google/callback"

GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=""
GITHUB_OAUTH_CLIENT_SECRET=""
GITHUB_OAUTH_REDIRECT_URI="http://localhost:4000/api/auth/oauth/github/callback"

DISCORD_OAUTH_ENABLED=false
DISCORD_OAUTH_CLIENT_ID=""
DISCORD_OAUTH_CLIENT_SECRET=""
DISCORD_OAUTH_REDIRECT_URI="http://localhost:4000/api/auth/oauth/discord/callback"

BOT_CHALLENGE_ENABLED=false
BOT_CHALLENGE_PROVIDER=turnstile
BOT_CHALLENGE_SIGNUP_MODE=off
BOT_CHALLENGE_PASSWORD_RESET_MODE=off
BOT_CHALLENGE_TIMEOUT_MS=5000
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Frontend public key, if used, belongs in the Vite env file as:
# VITE_TURNSTILE_SITE_KEY=""

EMAIL_PROVIDER="smtp"
SMTP_HOST="smtp.your-transactional-provider.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="smtp-user"
SMTP_PASS="smtp-password"
EMAIL_FROM="Findly <noreply@yourdomain.com>"
EMAIL_SECURITY_FROM="Findly Security <security@yourdomain.com>"
# Production note:
# - use a verified transactional sender domain
# - configure SPF, DKIM, and DMARC
# - do not use a personal mailbox as the long-term production sender

GOOGLE_PLACES_API_KEY=""
YELP_API_KEY=""
SEARCH_METADATA_PROVIDER_PRIMARY=serper
SEARCH_METADATA_PROVIDER_FALLBACK=serpapi
LIVE_SEARCH_METADATA_DISCOVERY_ENABLED=false
SEARCH_METADATA_MAX_QUERIES_PER_CAMPAIGN=5
SEARCH_METADATA_MAX_QUERY_LENGTH=180
SEARCH_METADATA_MIN_PROVIDER_RESULTS=3
SEARCH_METADATA_MIN_AVERAGE_CONFIDENCE=55
SERPER_API_KEY=""
SERPER_BASE_URL="https://google.serper.dev/search"
SERPER_TIMEOUT_MS=10000
SERPAPI_API_KEY=""
LIVE_SERP_DISCOVERY_ENABLED=false
SERPAPI_BASE_URL="https://serpapi.com/search.json"
SERPAPI_TIMEOUT_MS=10000
SERPAPI_MAX_QUERIES_PER_CAMPAIGN=5
DISCOVERY_DASHBOARD_SECRET_MANAGEMENT_ENABLED=false
DISCOVERY_SECRETS_MASTER_KEY=""

# AI keys are backend-only. Never expose these through VITE_ variables.
AI_ENABLED=false
AI_STRICT_SECURITY_MODE=true
AI_STORE_RAW_PAYLOADS=false
AI_LOG_PROMPTS=false
AI_LOG_RESPONSES=false
AI_ALLOW_PROMPT_LOGGING_IN_PRODUCTION=false
AI_DEFAULT_PROVIDER="gemini"
AI_DEFAULT_MODEL="gemini-2.5-flash"
AI_DEFAULT_TASK_PROVIDER="gemini"
AI_DEFAULT_TASK_MODEL="gemini-2.5-flash"
AI_ANALYSIS_ENABLED=false
AI_ANALYSIS_PROVIDER_CHAIN="gemini,openai,anthropic,deepseek,kimi,qwen,rule_based"
AI_ANALYSIS_TIMEOUT_MS=20000
AI_ANALYSIS_MAX_RETRIES=1
AI_ANALYSIS_CONCURRENCY=2
OPENAI_API_KEY=""
OPENAI_DEFAULT_MODEL=""
OPENAI_BASE_URL="https://api.openai.com/v1"
ANTHROPIC_API_KEY=""
ANTHROPIC_DEFAULT_MODEL=""
ANTHROPIC_BASE_URL="https://api.anthropic.com/v1"
GEMINI_API_KEY=""
GEMINI_DEFAULT_MODEL="gemini-2.5-flash"
DEEPSEEK_API_KEY=""
DEEPSEEK_DEFAULT_MODEL=""
DEEPSEEK_BASE_URL=""
KIMI_API_KEY=""
KIMI_DEFAULT_MODEL=""
KIMI_BASE_URL=""
QWEN_API_KEY=""
QWEN_DEFAULT_MODEL=""
QWEN_BASE_URL=""

# Generate only if dashboard-managed AI provider secrets are enabled:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AI_SECRETS_MASTER_KEY=""
AI_DASHBOARD_SECRET_MANAGEMENT_ENABLED=false

REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USER_AGENT="Findly/0.1 by your-reddit-username"
REDDIT_REFRESH_TOKEN=""
REDDIT_ACCESS_TOKEN_URL="https://www.reddit.com/api/v1/access_token"
REDDIT_API_BASE_URL="https://oauth.reddit.com"
REDDIT_REQUEST_TIMEOUT_MS=10000
REDDIT_MAX_RESULTS_DEFAULT=25
REDDIT_MAX_RESULTS_HARD_LIMIT=50

DATASET_IMPORT_DIR="../Data"
DATASET_IMPORT_MODE="global"
IMPORT_AS_ADMIN="true"

WEBSITE_FETCH_TIMEOUT_MS=5000
WEBSITE_FETCH_MAX_BYTES=512000
WEBSITE_FETCH_MAX_REDIRECTS=3
WEBSITE_ENRICHMENT_TTL_DAYS=30
OPEN_WEB_EVIDENCE_ENABLED=true
OPEN_WEB_EVIDENCE_PROVIDER=common_crawl
OPEN_WEB_EVIDENCE_FAIL_OPEN=true
OPEN_WEB_EVIDENCE_CACHE_TTL_DAYS=30
OPEN_WEB_EVIDENCE_MAX_RESULTS_PER_DOMAIN=5
OPEN_WEB_EVIDENCE_TIMEOUT_MS=6000
OPEN_WEB_EVIDENCE_USER_AGENT="FindlyOpenWebEvidence/0.1"
OPEN_WEB_EVIDENCE_MIN_CONFIDENCE_TO_SKIP_PAID=70
OPEN_WEB_EVIDENCE_MAX_URLS_PER_SEARCH=10
OPEN_WEB_EVIDENCE_ENABLE_SEARCH_ASSIST=true
OPEN_WEB_EVIDENCE_ENABLE_WEBSITE_JOBS=true
OPEN_WEB_EVIDENCE_ENABLE_DOMAIN_ENRICHMENT=true
COMMON_CRAWL_ENABLED=true
COMMON_CRAWL_INDEX_ID=latest
COMMON_CRAWL_INDEX_BASE_URL="https://index.commoncrawl.org"
COMMON_CRAWL_DATA_BASE_URL="https://data.commoncrawl.org"
COMMON_CRAWL_MAX_INDEX_RESULTS=10
COMMON_CRAWL_FETCH_WAT_ENABLED=false
# Bounded archive byte-range fetches are enabled by default for richer metadata.
# Keep the byte cap and timeout strict, and disable this first if private-beta monitoring
# shows slow archive responses or unnecessary network cost.
COMMON_CRAWL_FETCH_WARC_ENABLED=true
COMMON_CRAWL_MAX_WARC_BYTES=262144
COMMON_CRAWL_TIMEOUT_MS=6000
SOURCE_REQUEST_TIMEOUT_MS=10000
SOURCE_MAX_RESULTS_DEFAULT=20
SOURCE_MAX_RESULTS_HARD_LIMIT=100
JOB_STALE_TIMEOUT_MINUTES=60
ENABLE_WORKER=false
QUEUE_DRIVER=postgres
REDIS_URL=""
MAX_SEARCH_WORKER_CONCURRENCY=2
SEARCH_QUEUE_CONCURRENCY=2
SEARCH_QUEUE_RATE_LIMIT_MAX=
SEARCH_QUEUE_RATE_LIMIT_DURATION_MS=
WORKER_POLL_INTERVAL_MS=1000
WORKER_ID=""
MAX_QUEUED_SEARCH_JOBS=100
MAX_RUNNING_SEARCH_JOBS=10
MAX_ACTIVE_SEARCH_JOBS_PER_USER=2
LOCAL_DATASET_CANDIDATE_LIMIT=1000
CACHE_TTL_SECONDS=300
