generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  STARTER
  PRO
}

enum WorkspaceRole {
  OWNER
  MEMBER
}

enum CreditLedgerType {
  CREDIT_GRANTED
  CREDIT_USED
  CREDIT_REFUNDED
  PLAN_RESET
}

enum CreditReservationStatus {
  ACTIVE
  CAPTURED
  RELEASED
  CANCELLED
}

enum SearchSource {
  INSTAGRAM
  FACEBOOK
  GOOGLE_MAPS
  REDDIT
  LINKEDIN
  TIKTOK
  WEBSITE
  YELP
  TRIPADVISOR
  YOUTUBE
  X
  MANUAL
  OTHER
}

enum JobType {
  SEARCH_CAMPAIGN_RUN
  CAMPAIGN_ANALYSIS_RUN
  WEBSITE_ENRICHMENT_RUN
  EXPORT_RUN
}

enum JobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum CampaignStatus {
  DRAFT
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum LeadStatus {
  NEW
  REVIEWED
  CONTACTED
  INTERESTED
  NOT_A_FIT
  SAVED
  QUALIFIED
  DISQUALIFIED
  ARCHIVED
}

enum ScoreLevel {
  LOW
  MEDIUM
  HIGH
  GOLD
}

enum DatasetImportStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum DatasetImportRowStatus {
  IMPORTED
  SKIPPED
  DUPLICATE
  ERROR
}

model User {
  id                          String    @id @default(cuid())
  name                        String
  email                       String    @unique
  passwordHash                String
  avatarUrl                   String?
  role                        UserRole  @default(USER)
  plan                        Plan      @default(FREE)
  creditsBalance              Int       @default(0)
  emailVerified               Boolean   @default(false)
  emailVerifiedAt             DateTime?
  lastVerificationEmailSentAt DateTime?
  initialCreditsGrantedAt     DateTime?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  notifyReports               Boolean   @default(true)
  notifySecurity              Boolean   @default(true)
  notifyMarketing             Boolean   @default(false)
  twoFactorEnabled            Boolean   @default(false)

  sessions                Session[]
  emailVerificationTokens EmailVerificationToken[]
  ownedWorkspaces         Workspace[]              @relation("WorkspaceOwner")
  workspaceMembers        WorkspaceMember[]
  auditLogs               AuditLog[]
  creditLedger            CreditLedger[]
  creditReservations      CreditReservation[]
  serviceProfiles         ServiceProfile[]
  searchCampaigns         SearchCampaign[]
  leadLists               LeadList[]
  leads                   Lead[]
  leadAnalyses            LeadAnalysis[]
  opportunitySignals      OpportunitySignal[]
  jobs                    Job[]
  datasetImports          DatasetImport[]
  backendErrorLogs        BackendErrorLog[]

  @@index([createdAt])
  @@index([emailVerified])
  @@index([initialCreditsGrantedAt])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ipAddress String?
  userAgent String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([userId, usedAt, expiresAt])
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId, revokedAt, expiresAt])
}

model Workspace {
  id        String   @id @default(cuid())
  ownerId   String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner              User                @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members            WorkspaceMember[]
  creditLedger       CreditLedger[]
  creditReservations CreditReservation[]
  serviceProfiles    ServiceProfile[]
  searchCampaigns    SearchCampaign[]
  leadLists          LeadList[]
  leads              Lead[]
  leadAnalyses       LeadAnalysis[]
  opportunitySignals OpportunitySignal[]
  jobs               Job[]
  datasetImports     DatasetImport[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model BackendErrorLog {
  id         String   @id @default(cuid())
  requestId  String?
  userId     String?
  route      String?
  method     String?
  statusCode Int
  errorCode  String
  message    String
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([statusCode])
  @@index([errorCode])
  @@index([createdAt])
}

model CreditLedger {
  id            String           @id @default(cuid())
  userId        String
  workspaceId   String?
  type          CreditLedgerType
  amount        Int
  balanceAfter  Int
  reason        String
  referenceType String?
  referenceId   String?
  createdAt     DateTime         @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([createdAt])
}

model CreditReservation {
  id             String                  @id @default(cuid())
  userId         String
  workspaceId    String?
  campaignId     String?
  jobId          String?
  amount         Int
  capturedAmount Int                     @default(0)
  releasedAmount Int                     @default(0)
  status         CreditReservationStatus @default(ACTIVE)
  reason         String
  createdAt      DateTime                @default(now())
  capturedAt     DateTime?
  releasedAt     DateTime?
  updatedAt      DateTime                @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  campaign  SearchCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  job       Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([jobId])
  @@index([createdAt])
}

model ServiceProfile {
  id                  String   @id @default(cuid())
  userId              String
  workspaceId         String
  name                String
  serviceType         String
  targetBusinessTypes Json?
  targetLocations     Json?
  offerDescription    String?
  idealSignals        Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns SearchCampaign[]

  @@index([userId])
  @@index([workspaceId])
}

model SearchCampaign {
  id               String         @id @default(cuid())
  userId           String
  workspaceId      String
  serviceProfileId String?
  name             String
  query            String?
  country          String?
  city             String?
  businessTypes    Json?
  sources          Json?
  filters          Json?
  status           CampaignStatus @default(DRAFT)
  requestedLimit   Int            @default(50)
  resultCount      Int            @default(0)
  creditsReserved  Int            @default(0)
  creditsUsed      Int            @default(0)
  startedAt        DateTime?
  lockedAt         DateTime?
  lockedBy         String?
  errorMessage     String?
  errorCode        String?
  failedAt         DateTime?
  progressCurrent  Int            @default(0)
  progressTotal    Int            @default(0)
  lastStep         String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  completedAt      DateTime?

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  serviceProfile     ServiceProfile?     @relation(fields: [serviceProfileId], references: [id], onDelete: SetNull)
  leadLists          LeadList[]
  leads              Lead[]
  leadAnalyses       LeadAnalysis[]
  opportunitySignals OpportunitySignal[]
  jobs               Job[]
  creditReservations CreditReservation[]

  @@index([userId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
  @@index([workspaceId, status, createdAt])
}

model Job {
  id           String    @id @default(cuid())
  userId       String
  workspaceId  String
  campaignId   String?
  type         JobType
  status       JobStatus @default(QUEUED)
  payload      Json?
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  lockedAt     DateTime?
  lockedBy     String?
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  lastHeartbeatAt DateTime?
  cancelRequestedAt DateTime?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  SearchCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  creditReservations CreditReservation[]

  @@index([userId])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([type, status, createdAt])
  @@index([status, lockedAt])
  @@index([status, lastHeartbeatAt])
  @@index([cancelRequestedAt])
}

model LeadList {
  id              String   @id @default(cuid())
  userId          String
  workspaceId     String
  campaignId      String?
  name            String
  sourceRequested String?
  sourceUsed      String?
  fallbackUsed    Boolean  @default(false)
  searchMode      String?
  filters         Json?
  resultCount     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  SearchCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  leads     Lead[]
  leadItems LeadListLead[]

  @@index([userId])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([sourceUsed])
  @@index([createdAt])
}

model LeadListLead {
  id              String     @id @default(cuid())
  leadListId      String
  leadId          String?
  catalogLeadId   String?
  rank            Int        @default(0)
  score           Int?
  metadata        Json?
  status          LeadStatus @default(NEW)
  notes           String?
  userTags        Json?
  lastContactedAt DateTime?
  analysisStatus  String?
  analyzedAt      DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  leadList    LeadList       @relation(fields: [leadListId], references: [id], onDelete: Cascade)
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  catalogLead LeadCatalog?   @relation(fields: [catalogLeadId], references: [id], onDelete: Cascade)
  analyses    LeadAnalysis[]

  @@unique([leadListId, leadId])
  @@unique([leadListId, catalogLeadId])
  @@index([leadListId])
  @@index([leadId])
  @@index([catalogLeadId])
  @@index([status])
  @@index([updatedAt])
  @@index([analyzedAt])
}

model DatasetImport {
  id            String              @id @default(cuid())
  userId        String?
  workspaceId   String?
  fileName      String
  filePath      String?
  sourceType    String
  status        DatasetImportStatus @default(RUNNING)
  totalRows     Int                 @default(0)
  importedRows  Int                 @default(0)
  skippedRows   Int                 @default(0)
  duplicateRows Int                 @default(0)
  errorRows     Int                 @default(0)
  mapping       Json?
  summary       Json?
  startedAt     DateTime            @default(now())
  completedAt   DateTime?
  failedAt      DateTime?
  errorMessage  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  user         User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspace    Workspace?         @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  rows         DatasetImportRow[]
  leads        Lead[]
  catalogLeads LeadCatalog[]

  @@index([userId])
  @@index([workspaceId])
  @@index([sourceType])
  @@index([status])
  @@index([createdAt])
}

model DatasetImportRow {
  id             String                 @id @default(cuid())
  importId       String
  rowNumber      Int
  sheetName      String?
  status         DatasetImportRowStatus
  rawData        Json
  normalizedData Json?
  errorMessage   String?
  leadId         String?
  catalogLeadId  String?
  createdAt      DateTime               @default(now())

  import      DatasetImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  catalogLead LeadCatalog?  @relation(fields: [catalogLeadId], references: [id], onDelete: SetNull)

  @@index([importId])
  @@index([leadId])
  @@index([catalogLeadId])
  @@index([status])
}

model LeadCatalog {
  id                    String    @id @default(cuid())
  datasetImportId       String?
  businessName          String
  category              String?
  country               String?
  city                  String?
  address               String?
  phone                 String?
  whatsappNumber        String?
  email                 String?
  websiteUrl            String?
  websiteStatus         String?
  instagramUrl          String?
  instagramUsername     String?
  facebookUrl           String?
  googleMapsUrl         String?
  source                String?
  sourceId              String?
  sourceFile            String?
  rating                Float?
  reviewCount           Int?
  latitude              Float?
  longitude             Float?
  normalizedFingerprint String?
  rawData               Json?
  detectedSignals       Json?
  enrichmentData        Json?
  importedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  datasetImport     DatasetImport?     @relation(fields: [datasetImportId], references: [id], onDelete: SetNull)
  datasetImportRows DatasetImportRow[]
  leadListItems     LeadListLead[]

  @@index([datasetImportId])
  @@index([source])
  @@index([sourceId])
  @@index([sourceFile])
  @@index([instagramUsername])
  @@index([normalizedFingerprint])
  @@index([category])
  @@index([city])
  @@index([country])
  @@index([country, city])
  @@index([importedAt])
  @@index([createdAt])
}

model Lead {
  id                    String     @id @default(cuid())
  userId                String
  workspaceId           String
  leadListId            String?
  campaignId            String?
  datasetImportId       String?
  businessName          String
  category              String?
  country               String?
  city                  String?
  address               String?
  phone                 String?
  whatsappNumber        String?
  email                 String?
  websiteUrl            String?
  websiteStatus         String?
  instagramUrl          String?
  instagramUsername     String?
  facebookUrl           String?
  googleMapsUrl         String?
  source                String?
  sourceId              String?
  sourceFile            String?
  rating                Float?
  reviewCount           Int?
  latitude              Float?
  longitude             Float?
  normalizedFingerprint String?
  rawData               Json?
  detectedSignals       Json?
  enrichmentData        Json?
  status                LeadStatus @default(NEW)
  importedAt            DateTime?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leadList          LeadList?          @relation(fields: [leadListId], references: [id], onDelete: SetNull)
  campaign          SearchCampaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  datasetImport     DatasetImport?     @relation(fields: [datasetImportId], references: [id], onDelete: SetNull)
  datasetImportRows DatasetImportRow[]
  analyses          LeadAnalysis[]
  leadListItems     LeadListLead[]

  @@index([userId])
  @@index([workspaceId])
  @@index([leadListId])
  @@index([campaignId])
  @@index([datasetImportId])
  @@index([status])
  @@index([source])
  @@index([sourceId])
  @@index([sourceFile])
  @@index([instagramUsername])
  @@index([normalizedFingerprint])
  @@index([category])
  @@index([city])
  @@index([country])
  @@index([userId, workspaceId, status])
  @@index([workspaceId, source, sourceId])
  @@index([country, city])
  @@index([importedAt])
  @@index([createdAt])
}

model LeadAnalysis {
  id               String     @id @default(cuid())
  userId           String
  workspaceId      String
  leadId           String?
  leadListLeadId   String?
  campaignId       String?
  fitScore         Int?
  opportunityScore Int
  scoreLevel       ScoreLevel
  detectedSignals  Json
  reasons          Json
  suggestedService String
  outreachAngle    String
  messageDraft     String?
  confidence       String?
  nextBestAction   String?
  createdAt        DateTime   @default(now())

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead         Lead?           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadListLead LeadListLead?   @relation(fields: [leadListLeadId], references: [id], onDelete: Cascade)
  campaign     SearchCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([workspaceId])
  @@index([leadId])
  @@index([leadListLeadId])
  @@index([campaignId])
  @@index([scoreLevel])
  @@index([createdAt])
  @@unique([leadId])
  @@unique([leadListLeadId])
}

model OpportunitySignal {
  id              String    @id @default(cuid())
  userId          String
  workspaceId     String
  campaignId      String?
  source          String
  sourceId        String
  sourceUrl       String?
  title           String
  snippet         String?
  authorHash      String?
  subreddit       String?
  postedAt        DateTime?
  score           Int?
  commentCount    Int?
  matchedKeywords Json?
  detectedIntent  String?
  confidence      Int       @default(0)
  rawData         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaign  SearchCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, source, sourceId])
  @@index([userId])
  @@index([workspaceId])
  @@index([campaignId])
  @@index([source])
  @@index([sourceId])
  @@index([subreddit])
  @@index([detectedIntent])
  @@index([createdAt])
}

model FailedLoginAttempt {
  ipAddress  String
  emailHash  String
  attempts   Int      @default(1)
  expiresAt  DateTime

  @@id([ipAddress, emailHash])
  @@index([expiresAt])
}
